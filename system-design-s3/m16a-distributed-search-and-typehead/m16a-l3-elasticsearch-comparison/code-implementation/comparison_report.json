{
  "benchmark_queries": [
    {
      "id": "A1",
      "category": "ES Win: Morphological Stemming",
      "query": "replicating cache nodes",
      "rationale": "Tests stemming: Corpus has 'replication' (Doc 1 & 8). Homemade Boolean AND fails looking for exact 'replicating'. ES English stems to 'replic', achieving high recall."
    },
    {
      "id": "A2",
      "category": "ES Win: Disjunctive Candidate Retrieval",
      "query": "redis cache clustering and sharding",
      "rationale": "Tests disjunction: Doc 1 covers Redis/cache/cluster, Doc 3 covers sharding. Homemade Boolean AND fails because no single doc has all 4 terms. ES match (OR) surfaces and ranks both relevant documents."
    },
    {
      "id": "A3",
      "category": "ES Win: Stopword Filtering & IDF Weighting",
      "query": "how to achieve consensus across distributed servers",
      "rationale": "Tests conversational query: 'achieve' is absent from Doc 2. Homemade AND drops to 0 hits. ES English removes stopwords and weights 'consensus' and 'servers' heavily, placing Raft at Rank 1."
    },
    {
      "id": "B1",
      "category": "Homemade Win: Hyphenated Compound Terms",
      "query": "in-memory key-value",
      "rationale": "Tests compound preservation: Homemade regex keeps 'in-memory' and 'key-value' intact, matching Doc 1 with 100% precision. Standard analyzer splits punctuation into 4 tokens, causing false hits."
    },
    {
      "id": "B2",
      "category": "Homemade Win: Small-Corpus IDF Separation",
      "query": "scatter-gather",
      "rationale": "Tests IDF precision: Homemade unquantized float IDF yields high score separation for rare technical terms on tiny corpora, whereas Lucene quantizes norms to 1 byte."
    },
    {
      "id": "B3",
      "category": "Homemade Win: Microsecond Execution Latency",
      "query": "raft consensus leader election",
      "rationale": "Tests pure CPU speed: Homemade two-pointer merge runs in RAM in under 0.05ms with 0 serialization overhead, vs 3-8ms HTTP/REST round-trip."
    }
  ],
